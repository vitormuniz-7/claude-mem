# Credenciais da API REST do WordPress — um bloco por site.
# Copie para .env e preencha. O .env está no .gitignore e NUNCA deve ser commitado.
#
# *_WP_URL: sempre https://. Se o domínio ainda não estiver apontado, use a URL
#           temporária da Hostinger (ex.: https://xxxx.hostingersite.com).
# *_WP_USER: o LOGIN (não o e-mail) do usuário que gerou a senha de aplicativo.
# *_WP_APP_PASSWORD: gerada em Painel WP > Usuários > Perfil > Senhas de aplicativo
#           (nome sugerido: "Claude Code"). Pode colar com ou sem espaços.

# --- Site 1: Vitor Muniz, artista (vitindoclio.com.br) ---
VITINDOCLIO_WP_URL=https://vitindoclio.com.br
VITINDOCLIO_WP_USER=
VITINDOCLIO_WP_APP_PASSWORD=

# --- Site 2: Bromélia Groove (bromeliagroove.com.br) ---
BROMELIA_WP_URL=https://bromeliagroove.com.br
BROMELIA_WP_USER=
BROMELIA_WP_APP_PASSWORD=
